#将成功合并的目标站点数据的变量逐个进行处理，先处理温度，华氏度转摄氏度并另存为新的文件
"""
对每个站点的日值数据进行：
月平均：计算每个月份的平均气温（TEMP_C）、平均最高温（MAX_C）、平均最低温（MIN_C）
季节平均：按气象季节（12-2月、3-5月、6-8月、9-11月）计算季节平均
输出文件：每个站点生成对应的月平均和季节平均文件"""

import pandas as pd
import os
import numpy as np
from datetime import datetime

# ==================== 配置路径 ====================
# 输入文件夹（存放转换后摄氏度数据的路径）
input_dir = r"H:\百度数据\GSOD数据\untar\目标站点数据\转换后数据_摄氏度"

# 输出文件夹
output_dir = os.path.join(input_dir, "月平均_季节平均")
os.makedirs(output_dir, exist_ok=True)

# ==================== 定义季节函数 ====================
def get_season(month):
    """根据月份返回季节（正确处理冬季跨年）"""
    if month in [12, 1, 2]:
        return '冬季'
    elif month in [3, 4, 5]:
        return '春季'
    elif month in [6, 7, 8]:
        return '夏季'
    elif month in [9, 10, 11]:
        return '秋季'
    else:
        return '未知'

def get_season_year(year, month):
    """获取季节所属年份（冬季跨年处理）"""
    if month == 12:
        return year + 1  # 12月属于下一年的冬季
    else:
        return year

# ==================== 处理所有CSV文件 ====================
print("="*60)
print("开始计算月平均和季节平均")
print("="*60)

# 获取所有摄氏度CSV文件
csv_files = [f for f in os.listdir(input_dir) if f.endswith('_摄氏度.csv')]
print(f"找到 {len(csv_files)} 个文件需要处理\n")

processing_stats = []

for filename in csv_files:
    print(f"处理文件: {filename}")
    file_path = os.path.join(input_dir, filename)

    try:
        # 读取CSV文件
        df = pd.read_csv(file_path)
        print(f"  ├─ 原始数据行数: {len(df)}")

        # 检查必要的列
        required_cols = ['TEMP_C', 'MAX_C', 'MIN_C']
        date_col = None

        # 查找日期列
        if 'DATE' in df.columns:
            date_col = 'DATE'
        elif 'date' in df.columns:
            date_col = 'date'
        elif 'YEAR' in df.columns and 'MONTH' in df.columns and 'DAY' in df.columns:
            # 如果日期是分开的列，组合成日期
            df['DATE'] = pd.to_datetime(df[date_col], format='%Y/%m/%d', errors='coerce')
            date_col = 'DATE'
        else:
            # 尝试查找可能的日期列
            for col in df.columns:
                if 'date' in col.lower(): #字母转化为小写
                    date_col = col
                    break

        if date_col is None:
            print(f"  ✗ 错误: 找不到日期列")
            continue

        print(f"  ├─ 使用日期列: {date_col}")

        # 确保日期列是datetime类型
        df[date_col] = pd.to_datetime(df[date_col])

        # 提取年月信息
        df['year'] = df[date_col].dt.year
        df['month'] = df[date_col].dt.month

        # 获取站点信息
        station_name = filename.replace('_摄氏度.csv', '')

        # ==================== 1. 计算月平均 ====================
        print(f"  ├─ 计算月平均...")

        # 按年份和月份分组计算月平均
        monthly_avg = df.groupby(['year', 'month']).agg({
            'TEMP_C': 'mean',
            'MAX_C': 'mean',
            'MIN_C': 'mean'
        }).round(2)

        monthly_avg = monthly_avg.reset_index()
        monthly_avg.columns = ['年份', '月份', '月均温', '月平均最高温', '月平均最低温']

        # 添加季节信息
        monthly_avg['季节'] = monthly_avg['月份'].apply(get_season)

        # 计算各站点的多年各月平均
        multi_year_monthly = df.groupby('month').agg({
            'TEMP_C': 'mean',
            'MAX_C': 'mean',
            'MIN_C': 'mean'
        }).round(2)

        multi_year_monthly = multi_year_monthly.reset_index()
        multi_year_monthly.columns = ['月份', '多年月均温', '多年月平均最高温', '多年月平均最低温']
        multi_year_monthly['季节'] = multi_year_monthly['月份'].apply(get_season)

        # ==================== 2. 计算季节平均 ====================
        print(f"  ├─ 计算季节平均...")

        # 添加季节和季节年份
        df['season'] = df['month'].apply(get_season)
        df['season_year'] = df.apply(lambda row: get_season_year(row['year'], row['month']), axis=1)

        # 按季节年份和季节分组计算季节平均
        seasonal_avg = df.groupby(['season_year', 'season']).agg({
            'TEMP_C': 'mean',
            'MAX_C': 'mean',
            'MIN_C': 'mean'
        }).round(2)

        seasonal_avg = seasonal_avg.reset_index()
        seasonal_avg.columns = ['年份', '季节', '季节均温', '季节平均最高温', '季节平均最低温']

        # 按年份和季节排序
        season_order = {'春季': 1, '夏季': 2, '秋季': 3, '冬季': 4}
        seasonal_avg['季节顺序'] = seasonal_avg['季节'].map(season_order)
        seasonal_avg = seasonal_avg.sort_values(['年份', '季节顺序']).drop('季节顺序', axis=1)

        # ==================== 3. 计算年平均值（用于对比） ====================
        yearly_avg = df.groupby('year').agg({
            'TEMP_C': 'mean',
            'MAX_C': 'mean',
            'MIN_C': 'mean'
        }).round(2)

        yearly_avg = yearly_avg.reset_index()
        yearly_avg.columns = ['年份', '年均温', '年平均最高温', '年平均最低温']

        # ==================== 4. 保存结果 ====================
        # 生成输出文件名
        base_name = station_name

        # 保存月平均数据
        monthly_file = os.path.join(output_dir, f"{base_name}_月平均.csv")
        monthly_avg.to_csv(monthly_file, index=False, encoding='utf-8-sig')

        # 保存季节平均数据
        seasonal_file = os.path.join(output_dir, f"{base_name}_季节平均.csv")
        seasonal_avg.to_csv(seasonal_file, index=False, encoding='utf-8-sig')

        # 保存多年月平均（气候态）
        clim_monthly_file = os.path.join(output_dir, f"{base_name}_多年月平均.csv")
        multi_year_monthly.to_csv(clim_monthly_file, index=False, encoding='utf-8-sig')

        # 保存年平均值（可选）
        yearly_file = os.path.join(output_dir, f"{base_name}_年平均.csv")
        yearly_avg.to_csv(yearly_file, index=False, encoding='utf-8-sig')

        # 记录统计信息
        stats = {
            'station': station_name,
            'years': f"{df['year'].min()}-{df['year'].max()}",
            'total_days': len(df),
            'monthly_records': len(monthly_avg),
            'seasonal_records': len(seasonal_avg)
        }
        processing_stats.append(stats)

        print(f"  ├─ 年份范围: {stats['years']}")
        print(f"  ├─ 月平均记录: {stats['monthly_records']}条")
        print(f"  ├─ 季节平均记录: {stats['seasonal_records']}条")
        print(f"  └─ ✓ 已保存4个文件")

    except Exception as e:
        print(f"  ✗ 处理失败: {e}")
        import traceback
        traceback.print_exc()

# ==================== 生成汇总报告 ====================
report_file = os.path.join(output_dir, "计算报告.txt")
with open(report_file, 'w', encoding='utf-8') as f:
    f.write("="*60 + "\n")
    f.write("月平均和季节平均计算报告\n")
    f.write("="*60 + "\n")
    f.write(f"生成时间: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n")
    f.write(f"输入目录: {input_dir}\n")
    f.write(f"输出目录: {output_dir}\n")
    f.write("="*60 + "\n\n")

    f.write("季节定义:\n")
    f.write("  ├─ 春季: 3-5月\n")
    f.write("  ├─ 夏季: 6-8月\n")
    f.write("  ├─ 秋季: 9-11月\n")
    f.write("  └─ 冬季: 12-2月（冬季跨年，12月归入下一年）\n\n")

    f.write("处理文件统计:\n")
    f.write("-"*60 + "\n")

    for stats in processing_stats:
        f.write(f"站点: {stats['station']}\n")
        f.write(f"  ├─ 数据年份: {stats['years']}\n")
        f.write(f"  ├─ 总天数: {stats['total_days']}\n")
        f.write(f"  ├─ 月平均记录: {stats['monthly_records']}条\n")
        f.write(f"  └─ 季节平均记录: {stats['seasonal_records']}条\n\n")

    f.write("="*60 + "\n")
    f.write(f"共处理 {len(processing_stats)} 个站点\n")
    f.write(f"每个站点生成4个文件:\n")
    f.write(f"  1. {{站点名}}_月平均.csv - 逐年各月平均\n")
    f.write(f"  2. {{站点名}}_季节平均.csv - 逐年季节平均\n")
    f.write(f"  3. {{站点名}}_多年月平均.csv - 多年平均的各月气候态\n")
    f.write(f"  4. {{站点名}}_年平均.csv - 逐年平均\n")
    f.write("="*60 + "\n")

print("\n" + "="*60)
print(f"✅ 计算完成！")
print(f"✅ 共处理 {len(processing_stats)} 个站点")
print(f"✅ 结果保存在: {output_dir}")
print(f"✅ 报告文件: {report_file}")
print("="*60)

# ==================== 显示生成的文件 ====================
print("\n生成的文件列表:")
for file in sorted(os.listdir(output_dir)):
    if file.endswith('.csv'):
        file_path = os.path.join(output_dir, file)
        file_size = os.path.getsize(file_path) / 1024  # KB
        print(f"  ├─ {file} ({file_size:.1f} KB)")
