import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

# 设置中文显示
plt.rcParams['font.sans-serif'] = ['SimHei']
plt.rcParams['axes.unicode_minus'] = False

# 温度数据
temperature = np.array([6.65,6.05,6.85,6.23,5.50,6.28,6.39,7.25,6.52,6.76,
                        7.22,7.02,6.49,6.30,7.25,6.55,6.44,7.36,7.99,7.79,
                        7.08,7.48,7.74,7.13,7.52,7.19,7.95,7.80,7.23,7.77,
                        7.59,7.09,6.89,8.18,7.46,8.04,8.07,8.17,7.39,7.87,
                        7.73,8.34,8.38])

# 年份数据
years = np.arange(1980, 2023).reshape(-1, 1)  # 1980-2022，43年

# 合并为两列矩阵
MK = np.column_stack((years, temperature))

# 保存为.mat文件（Python用.npy或.csv格式）
np.save('data.npy', MK)  # 保存为numpy格式
# 或者保存为CSV
# np.savetxt('data.csv', MK, delimiter=',', header='year,temperature', comments='')

print("data.npy创建成功！")
print("数据预览:")
print(MK[:10, :])
# 提取年份和温度数据
year = MK[:, 0]
data = MK[:, 1]

# ==================== MK趋势检验 ====================
print("\n" + "="*50)
print("MK趋势检验")
print("="*50)

s = 0
n = len(data)

# 计算S统计量
for m in range(n-1):
    for k in range(m+1, n):
        if data[k] > data[m]:
            s += 1
        elif data[k] == data[m]:
            s += 0
        elif data[k] < data[m]:
            s -= 1

# 计算方差
vars_s = n * (n - 1) * (2 * n + 5) / 18

# 计算Z统计量
if s > 0:
    zc = (s - 1) / np.sqrt(vars_s)
elif s < 0:
    zc = (s + 1) / np.sqrt(vars_s)
else:
    zc = 0

print(f"S统计量: {s}")
print(f"Z统计量: {zc:.4f}")

# ==================== MK突变检验 - UFk ====================
print("\n" + "="*50)
print("MK突变检验 - UFk计算")
print("="*50)

Sk = np.zeros(n)
UF = np.zeros(n)
s1 = 0

for i in range(1, n):  # MATLAB中i从2到n，对应Python索引1到n-1
    for j in range(i+1):  # j从1到i
        if data[i] > data[j]:
            s1 += 1
    Sk[i] = s1
    E = i * (i + 1) / 4  # 注意：MATLAB中i*(i-1)/4，但索引不同需要调整
    Var = i * (i + 1) * (2 * i + 7) / 72  # 调整后的方差公式
    if Var > 0:
        UF[i] = (Sk[i] - E) / np.sqrt(Var)

print("UFk前10个值:")
print(UF[:])

# ==================== MK突变检验 - UBk ====================
print("\n" + "="*50)
print("MK突变检验 - UBk计算")
print("="*50)

# 反转数据
data2 = np.zeros(n)
for i in range(n):
    data2[i] = data[n - i - 1]

Sk2 = np.zeros(n)
UBk_temp = np.zeros(n)
s2 = 0

for i in range(1, n):
    for j in range(i+1):
        if data2[i] > data2[j]:
            s2 += 1
    Sk2[i] = s2
    E = i * (i + 1) / 4
    Var = i * (i + 1) * (2 * i + 7) / 72
    if Var > 0:
        UBk_temp[i] = 0 - (Sk2[i] - E) / np.sqrt(Var)

# 反转回原顺序
UB = np.zeros(n)
for i in range(n):
    UB[i] = UBk_temp[n - i - 1]

print("UBk前10个值:")
print(UB[:])
print(UBk_temp)

