mkruption = function(value, n){
   r=vector("integer", n)
   for (i in 2:n) {
      for (j in 1:i) {
         if (value[i]>value[j]) {
            r[i]=r[i]+1
         }
      }
      
   }
   sk = vector("integer", n)
   for (i in 2:n) {
      for (j in 1:i) {
         sk[i]=sk[i]+r[j]
      }
   }
   ufk = vector("integer",n)
   for (k in 2:n) {
      esk = k*(k-1)/4
      var = k*(k-1)*(2*k+5)/72
      ufk[k]=(sk[k]-esk)/sqrt(var)
   }
   return(ufk)
}
uf = mkruption(temp,n)
ub_rev=mkruption(rev(temp),n)
ub=rev(-ub_rev)

tb=tibble(uf=uf,ub=ub, year=data$year)
tb1=pivot_longer(tb,cols = -year)
ggplot(data=tb1)+
   geom_line(aes(x=year,y=value,color=name,group=name))+
